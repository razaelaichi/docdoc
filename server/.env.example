NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
# MongoDB Atlas connection string (never commit the real one)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/docdoc?retryWrites=true&w=majority
# comma-separated origins allowed to call the API with credentials
CORS_ORIGINS=http://localhost:5173
# number of reverse-proxy hops in front of the API (0 = direct)
TRUST_PROXY=0
# generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
PUBLIC_APP_URL=http://localhost:5173
UPLOAD_DIR=storage/uploads
UPLOAD_LINK_TTL_DAYS=7
# SMTP for verification / password-reset emails, e.g. smtps://user:pass@smtp.resend.com:465
# (unset in development: emails are printed to the log instead)
# SMTP_URL=
MAIL_FROM=DocDoc <no-reply@yourdomain.com>
# AI structuring via NVIDIA NIM (https://build.nvidia.com). Unset = extract text only.
# NVIDIA_API_KEY=
NIM_MODEL=nvidia/nemotron-3-super-120b-a12b
WORKER_CONCURRENCY=2
WORKER_METRICS_PORT=9464
