# Gateway: serves the SPA, proxies the API, keeps internal endpoints internal.
# TLS terminates in front of this (load balancer / ingress), which sets X-Forwarded-Proto.
#
# Template: the nginx image fills in ${API_UPSTREAM} from the environment at startup
# (docker compose: http://api:4000; a host like Render: the API service's own URL,
# e.g. https://docdoc-api.onrender.com).
limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;

# Any request that reached the load balancer over plain HTTP is sent to HTTPS.
map $http_x_forwarded_proto $plain_http {
  default 0;
  http 1;
}

server {
  listen ${NGINX_PORT};
  server_tokens off;
  client_max_body_size 160m; # 10 files x 15 MB plus multipart overhead; the API enforces the real limits

  if ($plain_http) {
    return 308 https://$host$request_uri; # 308 keeps the method and body
  }

  include /etc/nginx/snippets/security-headers.conf;

  # Compression: prebuilt .gz files (made at build time, maximum level) are served as-is;
  # anything else is compressed on the fly. Brotli (.br files are prebuilt too) is served by
  # the CDN edge, or here if the gateway image includes ngx_brotli (brotli_static on).
  gzip on;
  gzip_static on;
  gzip_vary on;
  gzip_min_length 1024;
  gzip_types application/javascript application/json text/css image/svg+xml text/plain application/manifest+json;

  location /api/ {
    limit_req zone=api burst=40 nodelay;
    proxy_pass ${API_UPSTREAM};
    # the upstream's own name: hosts like Render route by it (and it's needed for TLS SNI)
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_ssl_server_name on;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s; # PDF export
  }

  location /health/ {
    proxy_pass ${API_UPSTREAM};
    proxy_set_header Host $proxy_host;
    proxy_ssl_server_name on;
  }

  location = /metrics {
    return 404; # Prometheus scrapes the services directly on the private network
  }

  # Hashed build output: the file name changes whenever the content does, so cache forever.
  location /assets/ {
    root /usr/share/nginx/html;
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  # The app shell is revalidated on every visit (ETag / 304), so a deploy is picked up immediately.
  location / {
    root /usr/share/nginx/html;
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache" always;
    try_files $uri /index.html;
  }
}
