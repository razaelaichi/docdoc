    },
    {
      "id": 23,
      "title": "Connectivity problems",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 82,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {}
      },
      "targets": [
        {
          "expr": "sum by (job) (increase(mongodb_heartbeat_failures_total[15m]))",
