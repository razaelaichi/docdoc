    {
      "id": 22,
      "title": "Connection pool in use",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 82,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
