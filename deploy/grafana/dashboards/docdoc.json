      "title": "MongoDB command errors per minute",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 74,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {}
      },
      "targets": [
        {
          "expr": "sum by (job, command) (rate(mongodb_command_duration_seconds_count{outcome=\"error\"}[5m])) * 60",
